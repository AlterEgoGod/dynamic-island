<Border x:Name="LimitsCard" Background="{DynamicResource Card}" CornerRadius="16" Padding="14" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><Grid Margin="0,0,0,12"><TextBlock Text="Лимиты Codex" FontSize="13" FontWeight="SemiBold" /><Button x:Name="LimitsRefreshButton" Content="Обновить" HorizontalAlignment="Right" Padding="6,2" FontSize="10" Foreground="{DynamicResource Accent}" /></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><Grid Margin="0,0,0,7"><TextBlock Text="5 часов" FontSize="11" /><TextBlock x:Name="FiveHourValue" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid><ProgressBar x:Name="FiveHourBar" Maximum="100" /><TextBlock x:Name="FiveHourReset" Text="Сброс: —" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" /></StackPanel><StackPanel Grid.Column="2"><Grid Margin="0,0,0,7"><TextBlock Text="Неделя" FontSize="11" /><TextBlock x:Name="WeeklyValue" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid><ProgressBar x:Name="WeeklyBar" Maximum="100" /><TextBlock x:Name="WeeklyReset" Text="Сброс: —" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" /></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="LimitsStatus" Text="Получаем данные…" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" /><Button x:Name="LimitsLoginButton" Grid.Column="1" Content="Войти" Padding="8,2" FontSize="10" Foreground="{DynamicResource Accent}" Visibility="Collapsed" /></Grid></StackPanel></Border>