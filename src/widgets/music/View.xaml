<Border x:Name="MusicCard" Padding="14,10" Background="{DynamicResource Card}" CornerRadius="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="60" Height="60" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" ClipToBounds="True"><Grid><ContentControl x:Name="MusicCoverPlaceholder" Tag="icon:play" Width="28" Height="28" Foreground="{DynamicResource Accent}" /><Image x:Name="MusicCover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,60,60" RadiusX="12" RadiusY="12" /></Image.Clip></Image></Grid></Border><StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="MusicTrackTitle" Text="Музыка" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><TextBlock x:Name="MusicSummary" Text="Включите музыку в браузере или приложении" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><TextBlock x:Name="MusicAlbum" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel></Grid><StackPanel x:Name="MiniPlayerControls" Visibility="Collapsed" Margin="0,8,0,0"><Grid Height="22"><ProgressBar x:Name="MusicTrackProgress" Maximum="1" Height="3" AutomationProperties.Name="Прогресс трека" /><Slider x:Name="MusicSeek" Minimum="0" Maximum="1" SmallChange="5" LargeChange="15" IsMoveToPointEnabled="True" Visibility="Collapsed" AutomationProperties.Name="Перемотка трека" ToolTip="Нажмите на шкалу или перетащите ползунок" /></Grid><TextBlock x:Name="MusicTrackTime" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" /><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="MusicShuffle" Content="Случайно" FontSize="10" Padding="4,6" HorizontalAlignment="Left" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="MiniPrevious" Content="Назад" FontSize="11" Padding="8,5" ToolTip="Предыдущий трек" /><Button x:Name="MiniToggle" Style="{DynamicResource IconButton}" Width="44" Height="44" Background="{DynamicResource AccentSoft}" ToolTip="Воспроизведение / пауза" AutomationProperties.Name="Воспроизведение или пауза"><ContentControl x:Name="MiniPlayIcon" Tag="icon:play" Width="26" Height="26" Foreground="{DynamicResource Accent}" /></Button><Button x:Name="MiniNext" Content="Далее" FontSize="11" Padding="8,5" ToolTip="Следующий трек" /></StackPanel><Button x:Name="MusicRepeat" Grid.Column="2" Content="Повтор" FontSize="10" Padding="4,6" HorizontalAlignment="Right" /></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><Button x:Name="MusicMuteApp" Content="Звук" FontSize="10" Padding="4,4" /><Slider x:Name="MusicVolume" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True" Margin="8,0" AutomationProperties.Name="Громкость приложения" /><TextBlock x:Name="MusicVolumeValue" Grid.Column="2" Text="—" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" /></Grid><TextBlock x:Name="MusicVolumeHint" Text="Громкость приложения · для браузера — все вкладки" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel><Grid x:Name="MusicSourcesRow" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MusicSourceLabel" Text="Автоматический выбор" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource Muted}" /><Button x:Name="ChooseMusicSource" Grid.Column="1" Content="Источник" Padding="6,3" FontSize="11" Foreground="{DynamicResource Accent}" ToolTip="Автоматический выбор или конкретный проигрыватель" /></Grid><TextBlock x:Name="MiniPlayerMessage" Text="" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,5,0,0" /></StackPanel></Border>