<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="TimeWidgetView"><TextBlock x:Name="TimeWidgetHeading" Text="Время" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid x:Name="TimeCards"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="FocusCard" Background="{DynamicResource AccentSoft}" CornerRadius="18" Padding="14" MinHeight="166" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ContentControl Tag="icon:time" Width="20" Height="20" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" /><TextBlock Text="Таймер" FontSize="12" FontWeight="SemiBold" /></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBox x:Name="TimerLabel" Text="" Style="{DynamicResource TimerReadout}" Height="40" ToolTip="Нажмите, чтобы задать время · минуты или мин:сек · Enter — применить, Esc — отменить" AutomationProperties.Name="Время таймера, минуты или минуты и секунды" /><Button x:Name="TimerButton" Grid.Column="1" Style="{DynamicResource IconButton}" HorizontalAlignment="Right" Background="{DynamicResource Surface}" ToolTip="Запустить / приостановить таймер" AutomationProperties.Name="Запустить или приостановить таймер"><ContentControl x:Name="TimerIcon" Tag="icon:play" Width="24" Height="24" Foreground="{DynamicResource Accent}" /></Button></Grid><ScrollViewer Grid.Row="2" MaxHeight="62" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="FocusPresets" /></ScrollViewer><TextBlock x:Name="TimerHint" Grid.Row="3" Text="Выберите время для таймера" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" VerticalAlignment="Top" /><StackPanel Grid.Row="4" Margin="0,10,0,0"><ProgressBar x:Name="TimerProgress" Maximum="1" AutomationProperties.Name="Прогресс таймера" /><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="TimerRestart" Content="Заново" Padding="5,4" FontSize="11" HorizontalAlignment="Left" ToolTip="Остановить и вернуть заданное время" /><Button x:Name="TimerAddMinute" Grid.Column="1" Content="+1 мин" Padding="5,4" FontSize="11" HorizontalAlignment="Right" ToolTip="Добавить минуту, сохранив отсчёт" /></Grid></StackPanel></Grid></Border><Border x:Name="StopwatchCard" Background="{DynamicResource Card}" CornerRadius="18" Padding="14" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Column="2"><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="52" /><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ContentControl Tag="icon:stopwatch" Width="20" Height="20" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" /><TextBlock Text="Секундомер" FontSize="12" FontWeight="SemiBold" /></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,4,0"><TextBlock x:Name="StopwatchLabel" Text="00:00.0" FontSize="28" FontWeight="SemiBold" /></Viewbox><Button x:Name="StopwatchButton" Grid.Column="1" Style="{DynamicResource IconButton}" HorizontalAlignment="Right" Background="{DynamicResource Surface}" ToolTip="Запустить / приостановить секундомер" AutomationProperties.Name="Запустить или приостановить секундомер"><ContentControl x:Name="StopwatchIcon" Tag="icon:play" Width="24" Height="24" Foreground="{DynamicResource Accent}" /></Button></Grid><Button x:Name="StopwatchReset" Grid.Row="2" Content="Сбросить" HorizontalAlignment="Left" Padding="8,3" FontSize="11" Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface}" /><TextBlock x:Name="StopwatchStatus" Grid.Row="3" Text="Готов к старту" VerticalAlignment="Top" Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource Muted}" /></Grid></Border></Grid></StackPanel>