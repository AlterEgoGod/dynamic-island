<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dynamic Island" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Width="132" Height="8" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#FCFBFF" />
    <SolidColorBrush x:Key="Card" Color="#F3F0FA" />
    <SolidColorBrush x:Key="Ink" Color="#242133" />
    <SolidColorBrush x:Key="Muted" Color="#665F77" />
    <SolidColorBrush x:Key="Line" Color="#EAE5F4" />
    <SolidColorBrush x:Key="Accent" Color="#7041D9" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EEE7FF" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="FocusOutline" CornerRadius="12" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Background" Value="{DynamicResource Card}" />
    </Style>
    <Style x:Key="TimerReadout" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="TimeSurface" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="EmptyTime" Text="—:—" FontSize="28" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TimeSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="TimeSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="TimeSurface" Property="Background" Value="{DynamicResource Surface}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value="" />
                  <Condition Property="IsKeyboardFocusWithin" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="EmptyTime" Property="Visibility" Value="Visible" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="Height" Value="76" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value="" />
                  <Condition Property="IsKeyboardFocusWithin" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="5" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track">
              <Border Background="{TemplateBinding Background}" CornerRadius="3" />
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="{DynamicResource Line}" BorderBrush="{DynamicResource Accent}" BorderThickness="0">
              <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3" Fill="White" HorizontalAlignment="Left" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="1" Opacity="0.45" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="SmallChange" Value="50" />
      <Setter Property="LargeChange" Value="200" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22">
              <Border Height="4" Background="{DynamicResource Line}" CornerRadius="2" VerticalAlignment="Center" />
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"><Border Background="{DynamicResource Accent}" Height="4" CornerRadius="2" VerticalAlignment="Center" /></Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource Accent}" Stroke="{DynamicResource Surface}" StrokeThickness="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SourceMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="7" SnapsToDevicePixels="True">
          <StackPanel><TextBlock Text="ИСТОЧНИК ЗВУКА" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="11,6,11,8"/>
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
          <TextBlock Text="Включите трек в проигрывателе, чтобы он появился здесь." FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="11,8,11,5"/></StackPanel>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SourceMenuItem" TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"><ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="7,0"><TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{TemplateBinding Tag}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
          <Ellipse x:Name="Selected" Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Selected" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SourceMenuSeparator" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Line}" Margin="10,6"/></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <Canvas x:Name="PanelLayer">
      <Border x:Name="CollapsedBar" Width="132" Height="8" CornerRadius="0,0,5,5" Background="{DynamicResource Accent}" Cursor="SizeAll" ToolTip="Наведите для раскрытия · зажмите и перетащите к краю" />
      <Border x:Name="PanelBorder" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="0,0,26,26" ClipToBounds="True">
        <Grid>
          <Grid x:Name="PanelContent" Margin="24,22,24,24" Width="430" Height="632" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
              <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderDragZone" Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentSoft}" Width="36" Height="36" CornerRadius="12" HorizontalAlignment="Left">
                  <ContentControl Tag="icon:brand" Width="22" Height="22" Foreground="{DynamicResource Accent}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="AppHeading" Text="Dynamic Island" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Всё важное рядом" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="EditWidgetsButton" Style="{StaticResource IconButton}" ToolTip="Редактировать виджеты" AutomationProperties.Name="Редактировать виджеты"><ContentControl Tag="icon:edit" Width="22" Height="22"/></Button><Button x:Name="PinButton" Style="{StaticResource IconButton}" ToolTip="Оставить панель раскрытой" AutomationProperties.Name="Закрепить панель">
                  <ContentControl x:Name="PinIcon" Tag="icon:pin" Width="22" Height="22" />
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Настройки" AutomationProperties.Name="Настройки">
                  <ContentControl Tag="icon:setting" Width="22" Height="22" />
                </Button>
                <Button x:Name="HideButton" Style="{StaticResource IconButton}" ToolTip="Свернуть · Esc" AutomationProperties.Name="Свернуть">
                  <ContentControl Tag="icon:close" Width="22" Height="22" />
                </Button>
              </StackPanel>
            </Grid>
            <ScrollViewer x:Name="OverviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="Overview" Margin="0,16,0,0">
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
              <StackPanel x:Name="Settings" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="14">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="Тёмная тема" />
                      <CheckBox x:Name="DarkMode" HorizontalAlignment="Right" AutomationProperties.Name="Тёмная тема" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                      <TextBlock Text="Выровнять по центру" />
                      <CheckBox x:Name="CenterOnEdge" HorizontalAlignment="Right" AutomationProperties.Name="Выровнять по центру края" />
                    </Grid>
                    <TextBlock Text="При переносе — в центр ближайшего края" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,12" />
                    <Grid>
                      <TextBlock Text="Задержка сворачивания" FontSize="12" />
                      <TextBlock x:Name="DelayLabel" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12" />
                    </Grid>
                    <Slider x:Name="HideDelay" Minimum="0" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,6,0,0" AutomationProperties.Name="Задержка сворачивания" />
                    <TextBlock Text="0 мс — сразу после ухода мыши" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
                <StackPanel x:Name="WidgetSettingsHost" Margin="0,12,0,0" />
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="MusicPage" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Музыка" FontSize="22" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="MusicWide" Content="Шире" FontSize="11" Padding="10,6" Margin="0,0,6,0" Background="{DynamicResource Card}" ToolTip="Расширить остров для библиотеки и входа" />
                  <Button x:Name="MusicBack" Content="К виджету" FontSize="11" Padding="10,6" Background="{DynamicResource Card}" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="1">
                <UniformGrid Columns="3" Margin="0,0,-4,8">
                  <Button x:Name="MusicYandex" Content="Яндекс Музыка" FontSize="11" Padding="4,8" Margin="0,0,4,0" />
                  <Button x:Name="MusicSpotify" Content="Spotify" FontSize="11" Padding="4,8" Margin="0,0,4,0" />
                  <Button x:Name="MusicYoutube" Content="YouTube Music" FontSize="11" Padding="4,8" Margin="0,0,4,0" />
                </UniformGrid>
                <TextBlock x:Name="MusicNotice" Text="Войдите в аккаунт на странице сервиса." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="MusicBrowserLogin" Content="Войти через браузер" Background="{DynamicResource AccentSoft}" FontSize="12" Padding="10,9" Margin="0,0,8,0" />
                  <Button x:Name="MusicEmbedded" Grid.Column="1" Content="Внутри острова" FontSize="11" Padding="8,7" Background="{DynamicResource Card}" />
                </Grid>
              </StackPanel>
              <Border Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                  <Grid x:Name="MusicHost" />
                  <StackPanel x:Name="MusicPlaceholder" VerticalAlignment="Center" Margin="20">
                    <ContentControl Tag="icon:play" Width="32" Height="32" Foreground="{DynamicResource Accent}" Margin="0,0,0,12" />
                    <TextBlock x:Name="MusicMessage" Text="Автоматический выбор" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" />
                    <Button x:Name="InstallWebView" Content="Установить WebView2" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource AccentSoft}" />
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock x:Name="MusicStatus" Text="" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource Muted}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <UniformGrid x:Name="MusicWebToolbar" Columns="4" Margin="0,5,0,0">
                  <Button x:Name="MusicHome" Content="Главная" FontSize="11" Padding="3,7" />
                  <Button x:Name="MusicReload" Content="Обновить" FontSize="11" Padding="3,7" />
                  <Button x:Name="MusicMute" Content="Без звука" FontSize="11" Padding="3,7" />
                  <Button x:Name="MusicExternal" Content="В браузере" FontSize="11" Padding="3,7" />
                </UniformGrid>
              </StackPanel>
            </Grid>
            <Grid x:Name="MainFooter" Grid.Row="2" VerticalAlignment="Bottom">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Footer" Text="Перемещайте остров за ручку сверху" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <TextBlock x:Name="ShortcutLabel" Grid.Column="1" Text="Ctrl + Alt + Space" FontSize="10" Foreground="{DynamicResource Muted}" />
            </Grid>
            <Grid x:Name="SettingsActions" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ResetSettingsButton" Content="Сбросить все настройки" Padding="8,6" FontSize="11" HorizontalAlignment="Left" Foreground="{DynamicResource Muted}" ToolTip="Вернуть исходные настройки и остановить оба отсчёта" />
              <Button x:Name="QuitButton" Grid.Column="1" Content="Выйти" Padding="8,6" FontSize="11" Foreground="{DynamicResource Muted}" />
            </Grid>
          </Grid>
          <Border x:Name="Grip" Height="20" Width="72" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0" Background="Transparent" Cursor="SizeAll" ToolTip="Зажмите здесь, чтобы переместить остров" AutomationProperties.Name="Ручка перемещения острова"><Border Height="5" Width="38" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource Line}" IsHitTestVisible="False"/></Border>
        </Grid>
      </Border>
    </Canvas>
  </Grid>
</Window>
